#!/bin/sh -e

. sxmo_hook_icons.sh

dir="${XDG_DATA_HOME:-$HOME/.local/share}"/marker

delta_message() {
	_delta="$1"

	_weeks="$((_delta / 604800))"
	_delta="$((_delta % 604800))"
	_days="$((_delta / 86400))"
	_delta="$((_delta % 86400))"
	_hours="$((_delta / 3600))"
	_delta="$((_delta % 3600))"
	_minutes="$((_delta / 60))"
	_seconds="$((_delta % 60))"

	_message=
	_once=
	if ! [ 0 -eq "$_weeks" ]; then
		_message="$_weeks weeks"
		_once=1
	fi
	if ! [ 0 -eq "$_days" ]; then
		if [ -n "$_once" ]; then
			_message="$_message "
		fi
		_message="$_message$_days days"
		_once=1
	fi
	if ! [ 0 -eq "$_hours" ]; then
		if [ -n "$_once" ]; then
			_message="$_message "
		fi
		_message="$_message$_hours hours"
		_once=1
	fi
	if ! [ 0 -eq "$_minutes" ]; then
		if [ -n "$_once" ]; then
			_message="$_message "
		fi
		_message="$_message$_minutes minutes"
		_once=1
	fi
	if ! [ 0 -eq "$_seconds" ]; then
		if [ -n "$_once" ]; then
			_message="$_message "
		fi
		_message="$_message$_seconds seconds"
		_once=1
	fi

	printf %s "$_message"
}

show() {
	now="$(date +%s)"
	before="$(cat "$dir/$1")"
	delta="$((now - before))"
	if [ "$delta" = 0 ]; then
		printf "now"
	else
		delta_message "$delta"
	fi
	if [ -r "$dir/.$1" ]; then
		timeout="$(cat "$dir/.$1")"
		printf " ("
		delta_message "$timeout"
		printf ")"
	fi
	printf "\n"
}

delta() {
	now="$(date +%s)"
	before="$(cat "$dir/$1")"
	delta="$((now - before))"
	printf "%s\n" "$delta"
}

mark() {
	if [ -z "$1" ]; then
		exit 1
	fi
	file="$dir/$1"

	now="$(date +%s)"

	if ! [ -f "$file" ]; then
		printf %s "$now" > "$file"
		notify-send -u low "First entry!"
		exit
	fi

	before="$(cat "$file")"

	delta="$((now - before))"
	message="$(delta_message "$delta")"
	notify-send -u low "$message"

	printf %s "$now" > "$file"
}

list() {
	find -L "$dir" -not -name '\.*' \
		-mindepth 1 -exec basename {} \; |\
		while read -r filename; do
			printf "%s %s\n" "$(delta "$filename")" "$filename"
	done | sort -h | while read -r _ filename; do
		printf "%s: " "$filename"
		show "$filename"
	done
}

timeout_list() {
	find -L "$dir" -not -name '\.*' \
		-mindepth 1 -exec basename {} \; |\
		while read -r filename; do
			printf "%s %s\n" "$(delta "$filename")" "$filename"
	done | sort -h | while read -r _ filename; do
		printf "%s: " "$filename"
		if [ -r "$dir/.$filename" ]; then
			timeout="$(cat "$dir/.$filename")"
			delta_message "$timeout"
		else
			printf "none"
		fi
		printf "\n"
	done
}

status() {
	if [ -z "$1" ]; then
		find -L "$dir" -name '\.*' -mindepth 1 -exec basename {} \; | \
			cut -d. -f2- | \
			while read -r filename; do
				if [ -r "$dir/$filename" ]; then
					status "$filename"
				fi
		done
		return
	fi
	if ! [ -r "$dir/$1" ] || ! [ -r "$dir/.$1" ]; then
		exit 1
	fi
	timer="$(cat "$dir/.${1}")"
	delta="$(delta "$1")"
	percent="$(printf "scale=2;%s/%s*100\n" "$delta" "$timer" | bc | cut -d. -f1)"
	if [ "$percent" -ge 105 ]; then
		sxmobar -a -f red "marker-$1" 7 "$1"
	elif [ "$percent" -ge 100 ]; then
		sxmobar -a -f yellow "marker-$1" 7 "$1"
	elif [ "$percent" -ge 95 ]; then
		sxmobar -a -f green "marker-$1" 7 "$1"
	elif [ "$percent" -ge 90 ]; then
		sxmobar -a -f green "marker-$1" 7 "$1"
	else
		sxmobar -d "marker-$1"
	fi
}

monitor() {
	finish() {
		jobs -p | xargs kill > /dev/null 2>&1
		if [ -n "$fifo" ]; then
			rm "$fifo"
		fi
		exit
	}
	trap finish EXIT INT TERM

	fifo="$(mktemp -u)"
	mkfifo "$fifo"
	inotifywait -mq -e create,modify "$dir" >> "$fifo" &

	while read -r _; do
		status
	done < "$fifo" &

	while sleep "${1:-60}"; do
		status
	done &

	status
	wait
}

timeout_menu() {
	while : ; do
		entries="$(cat <<-EOF
			$icon_arl Return
			$(timeout_list)
			EOF
		)"
		picked="$(printf "%b\n" "$entries" | sxmo_dmenu.sh -p "Markers timeouts")" || return
		case "$picked" in
			""|"$icon_arl Return")
				return
				;;
			*:*)
				picked="$(printf "%s\n" "$picked" | cut -d: -f1)"
				;;
		esac
		if ! [ -r "$dir/$picked" ]; then
			continue
		fi
		entries="$(cat <<-EOF
			4w (4 weeks)
			4d (4 days)
			4h (4 hours)
			4m (4 minutes)
			4s (4 seconds)
			none (remove)
			EOF
		)"
		timeout="$(printf "%b\n" "$entries" | sxmo_dmenu.sh -p "Markers timeout "$picked"")" || continue
		if [ -z "$timeout" ]; then
			continue
		fi
		timeout="$(printf "%s\n" "$timeout" | cut -d" " -f1)"
		case "$timeout" in
			none)
				rm -f "$dir/.$picked"
				continue
				;;
			*w)
				timeout="$((${timeout%w} * 604800))"
				;;
			*d)
				timeout="$((${timeout%d} * 86400))"
				;;
			*h)
				timeout="$((${timeout%h} * 3600))"
				;;
			*m)
				timeout="$((${timeout%m} * 60))"
				;;
			*s)
				timeout="${timeout%s}"
				;;
			*)
				continue
		esac
		printf %s "$timeout" > "$dir/.$picked"
	done
}

menu() {
	while : ; do
		entries="$(cat <<-EOF
			$icon_cls Close menu
			$icon_clk Timeouts
			$(list)
			EOF
		)"
		picked="$(printf "%b\n" "$entries" | sxmo_dmenu.sh -p "Markers")" || return
		case "$picked" in
			""|"$icon_cls Close menu")
				return
				;;
			"$icon_clk Timeouts")
				timeout_menu
				;;
			*:*)
				name="$(printf "%s\n" "$picked" | cut -d: -f1)"
				# shellcheck disable=SC2086
		 		mark $name
				;;
			*)
				# shellcheck disable=SC2086
		 		mark $picked
				;;
		esac
	done
}

usage() {
	cat <<-EOF >&2
		$(basename "$0"):
		    mark <mark>
		    show <mark>
		    delta <mark>
		    status [mark]
		    list
		    menu
	EOF
}

# shellcheck disable=SC2068
case "$1" in
	mark) $@;;
	show|delta|list|status|menu|monitor) "$@";;
	*) usage; exit 1;;
esac
